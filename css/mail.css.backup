/* ============================================= */
/* MAIL MODULE v2.0 - Design Intuitif */
/* Inspiré section Rapports - Clair et pro */
/* ============================================= */

#view-mail {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--bg-primary);
  overflow-y: auto;
  padding: 2rem;
}

/* ===== HERO SECTION ===== */
.mail-hero {
  background: linear-gradient(135deg, rgba(15,15,25,0.95) 0%, rgba(20,20,35,0.95) 100%);
  border-radius: 24px;
  border: 1px solid rgba(212, 175, 55, 0.2);
  padding: 2rem;
  margin-bottom: 2rem;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}

.mail-hero-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
}

.mail-hero-title {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.mail-hero-title h1 {
  font-size: 2rem;
  font-weight: 700;
  margin: 0;
  background: linear-gradient(135deg, #fff, #d4af37);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.mail-hero-badge {
  padding: 0.5rem 1rem;
  border-radius: 2rem;
  font-size: 0.875rem;
  font-weight: 600;
}

.mail-hero-badge.ok {
  background: rgba(34, 197, 94, 0.1);
  color: #22c55e;
  border: 1px solid rgba(34, 197, 94, 0.3);
}

.mail-hero-badge.error {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.mail-hero-actions {
  display: flex;
  gap: 1rem;
}

.btn-lg {
  padding: 1rem 2rem;
  font-size: 1.125rem;
  font-weight: 600;
  gap: 0.75rem;
}

.btn-accent {
  background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
  color: #000;
  border: none;
  box-shadow: 0 4px 20px rgba(212, 175, 55, 0.3);
}

.btn-accent:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 28px rgba(212, 175, 55, 0.4);
}

/* Stats Cards */
.mail-hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.mail-stat-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  padding: 1.5rem;
  text-align: center;
  transition: all 0.3s ease;
}

.mail-stat-card:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(212, 175, 55, 0.3);
  transform: translateY(-4px);
}

.mail-stat-icon {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
}

.mail-stat-value {
  font-size: 2.5rem;
  font-weight: 700;
  background: linear-gradient(135deg, #fff, #d4af37);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 0.25rem;
}

.mail-stat-label {
  color: var(--text-secondary);
  font-size: 0.875rem;
}

/* ===== TABS NAVIGATION ===== */
.mail-tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 2rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16px;
  padding: 0.5rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.mail-tab {
  flex: 1;
  padding: 1rem 1.5rem;
  background: transparent;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  color: var(--text-secondary);
  font-weight: 500;
}

.mail-tab:hover {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-primary);
}

.mail-tab.active {
  background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
  color: #000;
  font-weight: 600;
  box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3);
}

.mail-tab-icon {
  font-size: 1.25rem;
}

.mail-tab-label {
  font-size: 0.9375rem;
}

/* ===== TAB CONTENT ===== */
.mail-tab-panel {
  animation: fadeInUp 0.3s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Section Headers */
.mail-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.mail-section-header h3 {
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0;
  color: var(--text-primary);
}

.mail-section-actions {
  display: flex;
  gap: 0.75rem;
}

/* ===== INBOX - Cards Grid ===== */
.mail-inbox-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.mail-filters {
  display: flex;
  gap: 0.5rem;
}

.mail-filter-btn {
  padding: 0.5rem 1rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.2s;
  font-size: 0.875rem;
}

.mail-filter-btn:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(212, 175, 55, 0.3);
}

.mail-filter-btn.active {
  background: rgba(212, 175, 55, 0.1);
  border-color: rgba(212, 175, 55, 0.5);
  color: var(--accent-primary);
}

.mail-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 1.5rem;
}

.mail-card {
  background: linear-gradient(135deg, rgba(15,15,25,0.95) 0%, rgba(20,20,35,0.95) 100%);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 16px;
  padding: 1.5rem;
  cursor: pointer;
  transition: all 0.3s ease;
}

.mail-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(212, 175, 55, 0.2);
  border-color: rgba(212, 175, 55, 0.4);
}

.mail-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 0.75rem;
}

.mail-card-to {
  font-size: 0.875rem;
  color: var(--text-secondary);
}

.mail-card-to strong {
  color: var(--accent-primary);
  margin-right: 0.25rem;
}

.mail-card-status {
  padding: 0.25rem 0.75rem;
  border-radius: 1rem;
  font-size: 0.75rem;
  font-weight: 600;
}

.mail-card-status.sent {
  background: rgba(34, 197, 94, 0.1);
  color: #22c55e;
}

.mail-card-status.opened {
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
}

.mail-card-status.failed {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}

.mail-card-subject {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 0.5rem;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mail-card-preview {
  color: var(--text-secondary);
  font-size: 0.875rem;
  line-height: 1.5;
  margin-bottom: 1rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mail-card-footer {
  display: flex;
  justify-content: space-between;
  font-size: 0.75rem;
  color: var(--text-tertiary);
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

/* ===== TEMPLATES GRID ===== */
.mail-templates-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
}

.mail-template-card {
  background: linear-gradient(135deg, rgba(15,15,25,0.95) 0%, rgba(20,20,35,0.95) 100%);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 16px;
  overflow: hidden;
  transition: all 0.3s ease;
}

.mail-template-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(212, 175, 55, 0.2);
  border-color: rgba(212, 175, 55, 0.4);
}

.mail-template-preview {
  height: 120px;
  background: rgba(0, 0, 0, 0.3);
  padding: 1rem;
  overflow: hidden;
  position: relative;
}

.mail-template-preview-content {
  font-size: 0.75rem;
  line-height: 1.4;
  color: var(--text-tertiary);
  opacity: 0.7;
}

.mail-template-info {
  padding: 1rem;
}

.mail-template-info h4 {
  margin: 0 0 0.5rem 0;
  font-size: 1rem;
  color: var(--text-primary);
}

.mail-template-subject {
  font-size: 0.875rem;
  color: var(--text-secondary);
  margin-bottom: 0.5rem;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mail-template-meta {
  font-size: 0.75rem;
  color: var(--text-tertiary);
}

.mail-template-actions {
  display: flex;
  gap: 0.5rem;
  padding: 0 1rem 1rem;
}

.mail-template-actions .btn {
  flex: 1;
}

/* ===== STATS MODULE ===== */
.mail-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.mail-stat-box {
  background: linear-gradient(135deg, rgba(15,15,25,0.95) 0%, rgba(20,20,35,0.95) 100%);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 16px;
  padding: 2rem;
  text-align: center;
}

.mail-stat-box-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.mail-stat-box-value {
  font-size: 2.5rem;
  font-weight: 700;
  background: linear-gradient(135deg, #fff, #d4af37);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 0.5rem;
}

.mail-stat-box-label {
  color: var(--text-secondary);
  font-size: 0.875rem;
}

.mail-stats-period {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.mail-stat-card h4 {
  margin: 0 0 1rem 0;
  color: var(--text-primary);
  font-size: 1rem;
}

.mail-stat-big {
  font-size: 3rem;
  font-weight: 700;
  background: linear-gradient(135deg, #fff, #d4af37);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin: 0;
}

.mail-stat-small {
  color: var(--text-secondary);
  font-size: 0.875rem;
  margin: 0.5rem 0 0 0;
}

.mail-activity-chart {
  background: linear-gradient(135deg, rgba(15,15,25,0.95) 0%, rgba(20,20,35,0.95) 100%);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 16px;
  padding: 2rem;
}

.mail-activity-chart h4 {
  margin: 0 0 1.5rem 0;
  color: var(--text-primary);
}

.mail-activity-bars {
  display: flex;
  gap: 1rem;
  align-items: flex-end;
  height: 200px;
}

.mail-activity-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  gap: 0.5rem;
}

.mail-activity-bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #d4af37 0%, #f4d03f 100%);
  border-radius: 8px 8px 0 0;
  transition: all 0.3s ease;
}

.mail-activity-bar:hover .mail-activity-bar-fill {
  background: linear-gradient(180deg, #f4d03f 0%, #d4af37 100%);
}

.mail-activity-bar-label {
  font-size: 0.75rem;
  color: var(--text-tertiary);
  text-transform: uppercase;
}

/* ===== MODALS ===== */
.mail-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

.mail-modal {
  background: linear-gradient(135deg, rgba(15,15,25,0.98) 0%, rgba(20,20,35,0.98) 100%);
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-radius: 24px;
  width: 90%;
  max-width: 600px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  animation: slideInUp 0.3s ease;
}

.mail-modal-large {
  max-width: 900px;
}

@keyframes slideInUp {
  from {
    transform: translateY(30px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.mail-modal-header {
  padding: 2rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mail-modal-header h3 {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--text-primary);
}

.mail-modal-close {
  width: 40px;
  height: 40px;
  background: rgba(255, 255, 255, 0.05);
  border: none;
  border-radius: 50%;
  cursor: pointer;
  font-size: 1.5rem;
  color: var(--text-secondary);
  transition: all 0.2s;
}

.mail-modal-close:hover {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
}

.mail-modal-body {
  flex: 1;
  padding: 2rem;
  overflow-y: auto;
}

.mail-modal-footer {
  padding: 1.5rem 2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: flex-end;
  gap: 1rem;
}

/* Form Elements */
.mail-form-group {
  margin-bottom: 1.5rem;
}

.mail-form-group label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 600;
  color: var(--text-primary);
}

.mail-form-group small {
  display: block;
  margin-top: 0.25rem;
  font-size: 0.75rem;
  color: var(--text-tertiary);
}

.mail-input, .mail-textarea {
  width: 100%;
  padding: 0.75rem 1rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  color: var(--text-primary);
  font-size: 0.9375rem;
  transition: all 0.2s;
}

.mail-input:focus, .mail-textarea:focus {
  outline: none;
  border-color: rgba(212, 175, 55, 0.5);
  background: rgba(255, 255, 255, 0.05);
}

.mail-textarea {
  resize: vertical;
  font-family: inherit;
}

/* Editor Toolbar */
.mail-editor-toolbar {
  display: flex;
  gap: 0.5rem;
  padding: 0.75rem;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12px 12px 0 0;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-bottom: none;
}

.mail-toolbar-btn {
  padding: 0.5rem 0.75rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.2s;
  font-weight: 600;
}

.mail-toolbar-btn:hover {
  background: rgba(212, 175, 55, 0.1);
  border-color: rgba(212, 175, 55, 0.3);
  color: var(--accent-primary);
}

.mail-editor {
  min-height: 200px;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 0 0 12px 12px;
  color: var(--text-primary);
  outline: none;
  line-height: 1.6;
}

.mail-editor:empty:before {
  content: attr(data-placeholder);
  color: var(--text-tertiary);
}

/* Empty & Loading States */
.mail-empty {
  text-align: center;
  padding: 4rem 2rem;
  color: var(--text-secondary);
}

.mail-empty-icon {
  font-size: 4rem;
  margin-bottom: 1rem;
  opacity: 0.5;
}

.mail-empty h3 {
  margin: 0 0 0.5rem 0;
  color: var(--text-primary);
}

.mail-loading {
  text-align: center;
  padding: 3rem;
  color: var(--text-secondary);
}

.mail-error {
  text-align: center;
  padding: 3rem;
  color: var(--error-color);
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
  .mail-hero-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .mail-stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .mail-cards-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  #view-mail {
    padding: 1rem;
  }

  .mail-hero {
    padding: 1.5rem;
  }

  .mail-hero-header {
    flex-direction: column;
    gap: 1rem;
  }

  .mail-hero-actions {
    width: 100%;
    flex-direction: column;
  }

  .mail-hero-stats {
    grid-template-columns: 1fr;
  }

  .mail-tabs {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .mail-tabs::-webkit-scrollbar {
    display: none;
  }

  .mail-tab {
    flex-shrink: 0;
    min-width: 120px;
  }

  .mail-stats-grid,
  .mail-stats-period {
    grid-template-columns: 1fr;
  }

  .mail-modal {
    width: 95%;
  }
}
