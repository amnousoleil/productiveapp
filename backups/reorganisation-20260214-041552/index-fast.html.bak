<!DOCTYPE html>
<html lang="fr" data-theme="midnight">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ProductiveApp - Ma Vision</title>
    <link rel="icon" type="image/png" href="/assets/images/logos/logo.svg">

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#d4af37">

    <!-- Preconnect (DNS resolution optimization) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">

    <!-- Preload critical resources -->
    <link rel="preload" href="/js/fast-loader.js?v=1200" as="script">
    <link rel="preload" href="/css/style-base.css?v=5000" as="style">
    <link rel="preload" href="/css/style-themes.css?v=1100" as="style">

    <!-- Critical CSS (loaded immediately) -->
    <link rel="stylesheet" href="/css/style-base.css?v=5000">
    <link rel="stylesheet" href="/css/style-themes.css?v=1100">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;450;500;600;700&display=swap" rel="stylesheet">

    <!-- Inline critical loading styles -->
    <style>
        #app-loading {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%);
            z-index: 9999;
            transition: opacity 0.5s ease;
        }
        #app-loading.fade-out {
            opacity: 0;
            pointer-events: none;
        }
        .loader-content {
            text-align: center;
        }
        .loader-logo {
            font-size: 72px;
            margin-bottom: 24px;
            animation: pulse 1.5s ease infinite;
            filter: drop-shadow(0 0 20px rgba(212, 175, 55, 0.5));
        }
        .loader-text {
            color: #d4af37;
            font-family: 'Inter', sans-serif;
            font-size: 20px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }
        .loader-subtext {
            color: rgba(212, 175, 55, 0.6);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            margin-top: 12px;
        }
        @keyframes pulse {
            0%, 100% {
                opacity: 0.6;
                transform: scale(1);
            }
            50% {
                opacity: 1;
                transform: scale(1.08);
            }
        }
    </style>
</head>
<body class="theme-midnight">
    <!-- Ultra-Fast Loading Screen -->
    <div id="app-loading">
        <div class="loader-content">
            <div class="loader-logo">⚡</div>
            <div class="loader-text">Mode Ultra-Rapide Activé</div>
            <div class="loader-subtext">Chargement en 3 phases...</div>
        </div>
    </div>

    <!-- App Container (populated by FastLoader) -->
    <div id="app-container" style="opacity: 0; transition: opacity 0.5s;">
        <div id="login-screen"></div>
        <div id="main-app" style="display: none;">
            <div id="sidebar"></div>
            <div class="main-content">
                <div id="view-container"></div>
            </div>
        </div>
    </div>

    <!-- Canvas (disabled by default, enabled post-login by AnimationsLite) -->
    <canvas id="matrix-bg" style="display: none;"></canvas>

    <!-- Service Worker Registration (Ultra-Fast caching) -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw-fast.js?v=1000')
                    .then(reg => {
                        console.log('✅ SW Fast registered:', reg.scope);
                    })
                    .catch(err => {
                        console.warn('⚠️ SW registration failed:', err);
                    });
            });
        }
    </script>

    <!-- FastLoader (intelligent 3-phase loading system) -->
    <script src="/js/fast-loader.js?v=1200"></script>

    <!-- Animations Lite (minimal for login, upgrades post-login) -->
    <script src="/js/animations-lite.js?v=1000"></script>

    <!-- Hide loader when app ready -->
    <script>
        window.addEventListener('appReady', (e) => {
            console.log(`🚀 App ready in ${e.detail.time}ms - MODE RAPIDE ACTIF !`);

            const loader = document.getElementById('app-loading');
            const app = document.getElementById('app-container');

            // Smooth fade out loader
            loader.classList.add('fade-out');
            app.style.opacity = '1';

            setTimeout(() => {
                loader.remove();
            }, 500);

            // Log performance metrics
            if (window.performance && window.performance.timing) {
                const perf = window.performance.timing;
                const loadTime = perf.loadEventEnd - perf.navigationStart;
                const domReady = perf.domContentLoadedEventEnd - perf.navigationStart;

                console.log(`📊 Performance Metrics:
                    • DOM Ready: ${domReady}ms
                    • Full Load: ${loadTime}ms
                    • Compression: ${document.documentElement.getAttribute('data-gzip') ? 'ACTIVE' : 'gzip active'}
                `);
            }
        });

        // Log phase completion
        window.addEventListener('phaseLoaded', (e) => {
            console.log(`✅ Phase "${e.detail.phase}" loaded in ${e.detail.duration}ms`);
        });
    </script>
</body>
</html>
